# Copy to .env. Compose reads this file; never commit the real .env.
POSTGRES_PASSWORD=crouton-local
# Host port only; containers always connect to db:5432.
POSTGRES_PORT=5432
DATABASE_URL=postgres://crouton:crouton-local@db:5432/crouton?sslmode=disable
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
# 0: begin at max(oldest available ledger, latest-100) on an empty database.
# A committed checkpoint always takes precedence over this setting.
START_LEDGER=0
BATCH_SIZE=10
POLL_INTERVAL=5s
RETRY_MAX=30s
API_MAX_LIMIT=100
API_LISTEN=:8080
